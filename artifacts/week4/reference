<script>
(function() {
    var url = window.location.href;

    // ==========================================
    // 1. TẠO THANH CUỘN DỌC CHO H5P (Chạy toàn hệ thống)
    // ==========================================
    function fixH5PScroll() {
        // Tìm tất cả khung iframe chứa nội dung H5P
        var iframes = document.querySelectorAll('iframe.h5p-iframe, iframe.h5p-player, iframe[src*="h5p"], .h5p-content iframe');
        iframes.forEach(function(iframe) {
            // Mở khóa cuộn cho iframe
            iframe.setAttribute('scrolling', 'yes');

            // Bọc iframe vào thẻ div cuộn riêng nếu chưa được bọc
            if (iframe.parentElement && !iframe.parentElement.classList.contains('h5p-scroll-wrapper')) {
                var wrapper = document.createElement('div');
                wrapper.className = 'h5p-scroll-wrapper';
                iframe.parentNode.insertBefore(wrapper, iframe);
                wrapper.appendChild(iframe);
            }
        });
    }

    // Tự động quét và bọc khung cuộn H5P liên tục khi trang tải
    var globalObserver = new MutationObserver(fixH5PScroll);
    globalObserver.observe(document.body, { childList: true, subtree: true });
    document.addEventListener("DOMContentLoaded", fixH5PScroll);

    // ==========================================
    // 2. ẨN MỤC "Other activities with questions" TRÊN TRANG NGÂN HÀNG CÂU HỎI
    // ==========================================
    if (url.includes("question/banks.php")) {
        var cleanPage = function() {
            var headings = document.querySelectorAll("#region-main h2, #region-main h3, .main-content h2, .main-content h3");
            headings.forEach(function(h) {
                if (h.textContent && h.textContent.includes("Other activities with questions")) {
                    h.style.setProperty("display", "none", "important");
                    var sib = h.nextElementSibling;
                    while (sib) {
                        sib.style.setProperty("display", "none", "important");
                        sib = sib.nextElementSibling;
                    }
                }
            });
        };
        document.addEventListener("DOMContentLoaded", cleanPage);
        setTimeout(cleanPage, 500);
        return;
    }

    // ==========================================
    // 3. TỰ ĐỘNG CHỌN NGÂN HÀNG TRONG QUIZ (mod/quiz/)
    // ==========================================
    if (!url.includes("mod/quiz/")) return;

    var quizObserver = new MutationObserver(function() {
        var modal = document.querySelector('.modal.show, div[role="dialog"]');
        if (!modal || modal.offsetWidth === 0) return;

        if (modal.dataset.autoHandled === "true") return;

        var fullText = (modal.textContent || "").toLowerCase();

        if (fullText.includes("current bank:") && fullText.includes("course question bank")) {
            modal.dataset.autoHandled = "true";
            return;
        }

        var courseHeader = Array.from(modal.querySelectorAll('*')).find(function(el) {
            return el.children.length === 0 && (el.textContent || '').trim().toLowerCase() === "question banks in this course";
        });

        if (courseHeader) {
            var quizHeader = Array.from(modal.querySelectorAll('*')).find(function(el) {
                return el.children.length === 0 && (el.textContent || '').trim().toLowerCase() === "this quiz question bank";
            });
            if (quizHeader) {
                quizHeader.style.setProperty("display", "none", "important");
            }

            var links = Array.from(modal.querySelectorAll('a, button, [role="button"]'));
            var targetLink = links.find(function(link) {
                var isAfter = (courseHeader.compareDocumentPosition(link) & Node.DOCUMENT_POSITION_FOLLOWING) !== 0;
                if (!isAfter) return false;
                var txt = (link.textContent || '').trim().toLowerCase();
                return txt !== "go back" && txt !== "switch bank" && txt !== "x" && txt !== "cancel" && !link.classList.contains("close") && !link.classList.contains("btn-close");
            });

            if (targetLink) {
                modal.dataset.autoHandled = "true";
                targetLink.click();
                return;
            }
        }

        var switchBtn = Array.from(modal.querySelectorAll("button, a")).find(function(b) {
            return (b.textContent || '').trim().toLowerCase() === "switch bank" && b.offsetWidth > 0;
        });

        if (switchBtn && !modal.dataset.switchedOnce) {
            modal.dataset.switchedOnce = "true";
            switchBtn.click();
        }
    });

    quizObserver.observe(document.body, { childList: true, subtree: true });
})();
</script>
